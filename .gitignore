x64/
x86/
[Dd]ebug/
[Rr]elease/
*.exe
*.pdb
*.ilk
*.idb
*.lib
*.dll
*.exp
*.tlog/
*.log
*.recipe
vc*.pdb
vc*.idb
ipch/
.vs/
