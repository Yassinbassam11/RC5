*.userosscache
*.sln.docstates
*.ncb
*.opendb
*.opensdf
*.sdf

# -----------------------------------------------
# Proteus / ISIS Simulation – Backup Files Only
# (keep rc5-simulation.pdsprj — intentionally committed)
# -----------------------------------------------
*[Autosaved]*.pdsprj
*[20[0-9][0-9]*]*.pdsprj
*.pdsprj.*.workspace
Project Backups/

# -----------------------------------------------
