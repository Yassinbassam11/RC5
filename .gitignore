# -----------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*.bak
*.orig
*~

# -----------------------------------------------
# IDE Personal Configs
# -----------------------------------------------
.idea/
.vscode/settings.json
*.code-workspace
